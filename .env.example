# Game Survey Workbench environment template
# Copy this file to .env, fill in a real LLM configuration, then run run.bat.

# Root folder for the local workspace. Default: workspace
GAME_SURVEY_WORKBENCH_WORKSPACE_ROOT=workspace

# LLM provider selector. Supported values today:
# - openai_compatible : OpenAI Responses / Chat Completions compatible API
# - fake              : local development/test-only stub, not for real validation
GAME_SURVEY_WORKBENCH_LLM_PROVIDER=openai_compatible

# Model name sent to the configured LLM endpoint.
GAME_SURVEY_WORKBENCH_LLM_MODEL=

# API key or bearer token for the configured provider.
GAME_SURVEY_WORKBENCH_LLM_API_KEY=

# Base URL for the provider endpoint.
GAME_SURVEY_WORKBENCH_LLM_BASE_URL=https://api.openai.com/v1

# Example: OpenAI API
# GAME_SURVEY_WORKBENCH_LLM_PROVIDER=openai_compatible
# GAME_SURVEY_WORKBENCH_LLM_MODEL=gpt-4.1
# GAME_SURVEY_WORKBENCH_LLM_API_KEY=sk-your-openai-key
# GAME_SURVEY_WORKBENCH_LLM_BASE_URL=https://api.openai.com/v1

# Example: Local Ollama OpenAI-compatible endpoint
# GAME_SURVEY_WORKBENCH_LLM_PROVIDER=openai_compatible
# GAME_SURVEY_WORKBENCH_LLM_MODEL=qwen2.5:14b
# GAME_SURVEY_WORKBENCH_LLM_API_KEY=ollama
# GAME_SURVEY_WORKBENCH_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Example: Fake provider for UI smoke testing only
# GAME_SURVEY_WORKBENCH_LLM_PROVIDER=fake
# GAME_SURVEY_WORKBENCH_LLM_MODEL=fake
# GAME_SURVEY_WORKBENCH_LLM_API_KEY=fake
# GAME_SURVEY_WORKBENCH_LLM_BASE_URL=http://localhost/fake
